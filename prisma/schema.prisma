  supplierProductName         String?
  /// WellPlayed Shopify product_type (Board Games, Card Games, …) — WEL category signal.
  supplierProductType         String?
  /// When KickDB is absent: feeds Decathlon `Genre` / Galaxus "Target group" (e.g. men, women, unisex).
  supplierGender              String?
  /// When KickDB is absent: feeds Decathlon `Couleur` / Galaxus "Color" (e.g. Cement / Black).
  supplierColorway            String?
