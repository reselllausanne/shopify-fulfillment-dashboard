/// Staff return-receipt workflow (scan → receive → refund → close). Separate from DecathlonReturn restock sync.
model MarketplaceReturn {
  id                  String    @id @default(uuid())
  platform            String    @default("decathlon")
  externalReturnId    String
  externalOrderId     String
  externalOrderLineId String?
  productId           String?
  productTitle        String?
  sku                 String?
  returnLabelNumber   String?
  /// UUID key identifying the return label file in Supabase storage (return-labels/ prefix). Used to build the download URL.
  labelKey            String?
  /// S3 storage URL (s3://bucket/key) for the return label in Supabase. Used by the API route to fetch the file.
  labelStorageUrl     String?
  returnAmount        Decimal   @db.Decimal(12, 2)
  currency            String    @default("CHF")
  returnReasonCode    String?
  returnReasonLabel   String?
  miraklStatus        String?
  localStatus         String    @default("pending_receipt")
  /// pending | receive_done | refund_done | close_done — drives idempotent retry
  processStep         String    @default("pending")
  syncedAt            DateTime?
  receivedAt          DateTime?
  completedAt         DateTime?
  failureMessage      String?
  staffNote           String?
  quantity            Int       @default(1)
  apiSource           String?
  receiveActionId     String?
  refundIdsJson       Json?
  closeActionId       String?
  auditLogJson        Json?
  rawJson             Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([platform, externalReturnId])
  @@index([platform, returnLabelNumber])
  @@index([localStatus])
  @@index([externalOrderId])
  @@map("marketplace_returns")
  @@schema("public")
}

