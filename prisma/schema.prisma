/// Shopify sync workflow state — separate from product data so marketplace flows never touch it.
/// One row per KickDB product that is (or should become) a Shopify product. Starts empty; filled
/// by the bootstrap job and by /api/kickdb/mark-synced after each successful Shopify push.
model ShopifySyncState {
  id               String    @id @default(uuid())
  kickdbProductId  String    @unique
  shopifyProductId String?
  shopifyHandle    String?
  /// pending | synced | error | create_candidate
  syncStatus       String    @default("pending")
  shopifySyncedAt  DateTime?
  priorityScore    Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product KickDBProduct @relation(fields: [kickdbProductId], references: [kickdbProductId], onDelete: Cascade)

  @@index([syncStatus, updatedAt])
  @@schema("public")
}

/// Mirror of Shopify per-location inventory. Shopify is the master for PHYSICAL
/// stock (Bussigny / shops); this table makes that per-location truth visible to
/// the DB/marketplace side so feeds can compute effective availability
/// (Σ physical + dropship) and know WHICH location holds a unit when a sale
/// lands on any channel. `sourceType`: 'physical' (warehouse/shops) | 'online'
/// (Chemin de Bas-de-Plan = StockX dropship). One row per (variant, location);
/// only stocked rows are kept (available > 0), plus rows zeroed on sell-out.
model ShopifyVariantLocationStock {
  id               String   @id @default(uuid())
  shopifyVariantId String
  inventoryItemId  String
  sku              String?
  gtin             String?
  locationId       String
  locationName     String
  /// 'physical' | 'online'
  sourceType       String
  /// Lower = sold first. Bussigny=1, Antica=2, THE LAB=3, COLD BIEN=4, dropship=99.
  priority         Int      @default(99)
  available        Int      @default(0)
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shopifyVariantId, locationId])
  @@index([locationId, available])
  @@index([sku])
  @@index([gtin])
  @@index([sourceType, available])
  @@schema("public")
}

/// Owned physical stock with cost + origin. Mirror (`ShopifyVariantLocationStock`)
/// stays the qty-by-location sync from Shopify; this table is the ledger for
/// matching/margin (which unit, why it's there, what cost to use on resale).
/// No separate reservation table: sale matching decrements qtyAvailable in a tx.
model LocalStockLot {
  id                        String             @id @default(uuid())
  shopifyProductId          String?
  shopifyVariantId          String
  inventoryItemId           String?
  sku                       String?
  gtin                      String?
  sizeLabel                 String?
  locationId                String
  locationName              String
  origin                    LocalStockOrigin
  costBasis                 LocalStockCostBasis
  unitCostChf               Decimal            @db.Decimal(10, 2)
  currencyCode              String             @default("CHF")
  qtyInitial                Int
  qtyAvailable              Int
  qtySold                   Int                @default(0)
  /// OPEN | DEPLETED | QUARANTINED
  status                    String             @default("OPEN")
  sourceOrderMatchId        String?
  sourceMarketplaceReturnId String?
  enteredAt                 DateTime           @default(now())
  notes                     String?
  /// Idempotent migration / intake key (e.g. returnMatch:<id>).
  migrationKey              String?            @unique
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  sourceOrderMatch OrderMatch?  @relation("LocalStockSourceMatch", fields: [sourceOrderMatchId], references: [id], onDelete: SetNull)
  saleMatches      OrderMatch[] @relation("LocalStockSaleLot")

  @@index([shopifyVariantId, status, qtyAvailable])
  @@index([sku, qtyAvailable])
  @@index([gtin, qtyAvailable])
  @@index([locationId, qtyAvailable])
  @@index([sourceOrderMatchId])
  @@schema("public")
}

