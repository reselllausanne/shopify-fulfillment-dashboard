# Google Ads analytics POC (phase 1) — read-only.
# Not an exhaustive list of the app's environment; only what `npm run ads` needs.
# Copy the block into your local .env (git-ignored) or /etc/resell/*.env on the VPS
# with permissions 600. Never commit real values.

# Approved developer token from the Google Ads API Center of the MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth desktop/web client from Google Cloud Console.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token obtained once with scope https://www.googleapis.com/auth/adwords
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account ID, digits only. Leave empty for a standalone account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Account actually queried, digits only (no dashes).
GOOGLE_ADS_CUSTOMER_ID=
# Configurable so a version bump never requires a code change.
GOOGLE_ADS_API_VERSION=v25

# Reserved for phase 2 (Merchant API); unused today.
MERCHANT_CENTER_ACCOUNT_ID=

# Existing app database, reused as-is (Prisma).
DATABASE_URL=
DIRECT_URL=

APP_TIMEZONE=Europe/Zurich

# ---------------------------------------------------------------------------
# Personal health / triathlon module (admin-only). Never commit real values.
# ---------------------------------------------------------------------------
# 64 hex chars (32 bytes) or any passphrase (sha256-derived). Required to store OAuth tokens.
HEALTH_TOKEN_ENCRYPTION_KEY=
# Optional public base URL for OAuth redirects / webhooks (e.g. https://your-host).
HEALTH_PUBLIC_BASE_URL=
HEALTH_WEBHOOK_SECRET=

# Garmin Connect Developer Program (after approval). Leave empty → mock_garmin provider.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# WHOOP Developer API — create app at https://developer.whoop.com/
# Redirect URI must match Dashboard exactly:
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://solution.resell-lausanne.ch/api/health/integrations/whoop/callback

# Partner Galaxus self-fulfill pilot gate.
# Enable with 1/true/yes/on, then optionally scope by provider keys (comma-separated), e.g. NER
PARTNER_SELF_FULFILL_ENABLED=
PARTNER_SELF_FULFILL_ALLOWLIST=
