# Google Ads analytics POC (phase 1) — read-only.
# Not an exhaustive list of the app's environment; only what `npm run ads` needs.
# Copy the block into your local .env (git-ignored) or /etc/resell/*.env on the VPS
# with permissions 600. Never commit real values.

# Approved developer token from the Google Ads API Center of the MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth desktop/web client from Google Cloud Console.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token obtained once with scope https://www.googleapis.com/auth/adwords
GOOGLE_ADS_REFRESH_TOKEN=
# Optional dedicated Merchant refresh token (content scope). If set, Merchant API
# commands use this token in priority over GOOGLE_ADS_REFRESH_TOKEN.
GOOGLE_MERCHANT_REFRESH_TOKEN=
# Manager (MCC) account ID, digits only. Leave empty for a standalone account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Account actually queried, digits only (no dashes).
GOOGLE_ADS_CUSTOMER_ID=
# Configurable so a version bump never requires a code change.
GOOGLE_ADS_API_VERSION=v25

# Reserved for phase 2 (Merchant API); unused today.
MERCHANT_CENTER_ACCOUNT_ID=

# Existing app database, reused as-is (Prisma).
# DATABASE_URL = Supabase *transaction* pooler (:6543) + pgbouncer=true + connection_limit≤5.
# DIRECT_URL   = Supabase *session* pooler (:5432) for long jobs (feed export, STX refresh).
# Do NOT point long jobs at :6543 — they die with "Can't reach database server".
DATABASE_URL=
DIRECT_URL=

# STX price/stock refresh shards (ops-background). ~8k products/run ≈ full catalog/day.
# STX_REFRESH_PRODUCT_BATCH=8000
# STX_REFRESH_CONCURRENCY=4

APP_TIMEZONE=Europe/Zurich

# Legacy THE warehouse supplier (partner CSV / THE_* rows). Disabled by default.
# Physical stock uses Shopify mirror + STX_/NER_. THE LAB location is unrelated.
# THE_SUPPLIER_ENABLED=true

# ---------------------------------------------------------------------------
# Personal health / triathlon module (admin-only). Never commit real values.
# ---------------------------------------------------------------------------
# 64 hex chars (32 bytes) or any passphrase (sha256-derived). Required to store OAuth tokens.
HEALTH_TOKEN_ENCRYPTION_KEY=
# Optional public base URL for OAuth redirects / webhooks (e.g. https://your-host).
HEALTH_PUBLIC_BASE_URL=
HEALTH_WEBHOOK_SECRET=

# Garmin Connect Developer Program (after approval). Leave empty → mock_garmin provider.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# WHOOP Developer API — create app at https://developer.whoop.com/
# Redirect URI must match Dashboard exactly:
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://solution.resell-lausanne.ch/api/health/integrations/whoop/callback

# Partner Galaxus self-fulfill pilot gate.
# Enable with 1/true/yes/on, then optionally scope by provider keys (comma-separated), e.g. NER
PARTNER_SELF_FULFILL_ENABLED=
PARTNER_SELF_FULFILL_ALLOWLIST=

# QZ Tray silent print (server only). Local: ./scripts/setup-qz-local.sh
# QZ_PUBLIC_CERT=
# QZ_PRIVATE_KEY=

# Shopify custom pixel funnel ingest (POST /api/track/funnel). Public write key:
# also embedded in docs/tracking/shopify-custom-pixel.js (generate ready copy locally). Unset = endpoint returns 503.
# Generate: openssl rand -hex 24
FUNNEL_TRACK_KEY=
# Optional CORS allowlist override (comma-separated). Default: resell-lausanne.ch, www., null (pixel sandbox).
# FUNNEL_TRACK_ORIGINS=

# --- Shadow tracking (docs/tracking/TRACKING-PLAN.md). Outbound destinations are code-locked in
# Phase 1 (tracking/guards.ts); these keys are inert until the matching gate PR lifts a lock.
# TRACKING_SHADOW_MIN_COVERAGE_PCT=80
# FUNNEL_EVENTS_RETENTION_MONTHS=14
# TRACKING_CM2_VAT_RATE=0.081
# TRACKING_CM2_PAYMENT_FEE_PCT=0.029
# TRACKING_CM2_PAYMENT_FEE_FIXED=0.3
# TRACKING_CM2_SHIPPING_COST=9
# TRACKING_CM2_RETURN_RESERVE_PCT=0.02
# TRACKING_GA4_TEST_ENABLED=0
# TRACKING_GA4_TEST_APPROVED_AT=
# TRACKING_GA4_TEST_MEASUREMENT_ID=
# G4 Secondary click upload (never a Simprosys / Primary action id):
# TRACKING_GOOGLE_ADS_SECONDARY_ENABLED=0
# TRACKING_GOOGLE_ADS_SECONDARY_APPROVED_AT=   # YYYY-MM-DD after explicit approval
# TRACKING_GOOGLE_ADS_SECONDARY_ACTION_ID=    # new UPLOAD_CLICKS Secondary only
# Optional Friday digeste mail: TRACKING_WEEKLY_MAILTO=ops@example.com
# TRACKING_META_ENABLED=0
# TRACKING_META_APPROVED_AT=
# TRACKING_META_PIXEL_ID=
# TRACKING_TIKTOK_ENABLED=0
# TRACKING_TIKTOK_APPROVED_AT=
# TRACKING_TIKTOK_PIXEL_ID=

# --- Server-side GTM (docs/tracking/SGTM-VPS.md) — OFF unless COMPOSE_PROFILES=sgtm ---
# COMPOSE_PROFILES=sgtm
SGTM_CONTAINER_CONFIG=
# SGTM_PREVIEW_SERVER_URL=https://sgtm-preview.resell-lausanne.ch
# SGTM_IMAGE_TAG=stable

# --- StockX browser remint via residential proxy (optional) ---
# GraphQL already uses SCRAPER_PROXY_* / .data/reichelt-proxies.txt.
# Browser remint (Playwright) can fall back to the same pool when VPS IP hits Turnstile.
# STOCKX_BROWSER_PROXY_MODE=off | on_fail | always   (default / VPS: on_fail — NEVER always)
# Bandwidth guard (LemonPrime bills GB, not stickies):
# STOCKX_BLOCK_HEAVY=1   (default) block image/media/font + trackers on checkout → ~80% fewer bytes
# STOCKX_PROXY_MAX_MB=500 (default) hard per-session ceiling; aborts requests if a CF loop runs away
# Real MB per session logged to .data/stockx-proxy-usage.jsonl
# STOCKX_PROXY_COUNTRY=ch
# STOCKX_PROXY_SERVER=http://gw.example:5555
# STOCKX_PROXY_USERNAME=
# STOCKX_PROXY_PASSWORD=
# STOCKX_PROXY_URL=http://user:pass@gw.example:5555
# Or reuse scraper pool: SCRAPER_PROXY_FILE=.data/reichelt-proxies.txt

# SAV agent (page /sav + container sav-agent). Put in VPS .env.
# CURSOR_API_KEY=            # cursor.com/dashboard/integrations
# SAV_AGENT_TOKEN=           # random long string, shared web <-> sav-agent
# SAV_PASSWORD=              # password for the SAV person at /login (role "sav")
# SAV_DATABASE_URL=          # postgres URL for role sav_readonly (scripts/sav-readonly-role.sql)
# SAV_IMAP_USER=             # SAV mailbox
# SAV_IMAP_PASSWORD=         # Gmail app password
# SAV_NTFY_TOPIC=            # long unguessable ntfy topic, subscribe on phone

# ---------------------------------------------------------------------------
# Warehouse & Partners module (Entrepôt) — lot 1. See docs/warehouse/README.md.
# Everything is OFF unless WAREHOUSE_MODULE_ENABLED is set: routes answer 404,
# the "Entrepôt" navigation and the partner stock sections are hidden.
# The module has no outbound connector (no Shopify / Galaxus / EDI / carrier call).
# ---------------------------------------------------------------------------
# WAREHOUSE_MODULE_ENABLED=true
# Stop switch: false = read-only (scans, lists and the partner portal keep working).
# WAREHOUSE_WRITES_ENABLED=true
# Partner keys that see their held stock. Empty = no partner, * = every partner.
# WAREHOUSE_PARTNER_ALLOWLIST=TONY
# Site codes where stock may enter (batches, new labels). Empty = every site.
# WAREHOUSE_PILOT_SITES=CH01
# Label issuance journal, on a disk that is NOT the database disk (JSONL, append-only).
# WAREHOUSE_LABEL_JOURNAL_DIR=/var/lib/resell/warehouse-journal
# true = a pair label is only printed once its journal line reached that directory.
# WAREHOUSE_LABEL_JOURNAL_ENFORCE=false
# Minutes a proposed shelf place stays reserved (default 480).
# WAREHOUSE_RESERVATION_TTL_MINUTES=480
# Seconds before a claimed print job with no answer becomes "uncertain" (default 90).
# WAREHOUSE_PRINT_CLAIM_TIMEOUT_SECONDS=90
# Hours after which a pending putaway is reported as stale (default 24).
# WAREHOUSE_STALE_TASK_HOURS=24
# Minutes without a scan after which a level count must be resumed by scanning the level again (default 30).
# WAREHOUSE_COUNT_SESSION_IDLE_MINUTES=30
