#!/usr/bin/env node
// Full SQL on prod DB (read + write). Usage: sav-sql "<sql>" | --tables | --schema <Table>
import pg from "pg";
const url = process.env.DATABASE_URL || process.env.DIRECT_URL;
const arg = process.argv.slice(2);
let sql = arg[0] ?? "";
if (sql === "--tables") sql = `select table_name from information_schema.tables where table_schema='public' order by 1`;
else if (sql === "--schema") sql = `select column_name, data_type from information_schema.columns where table_schema='public' and table_name='${String(arg[1] ?? "").replace(/[^A-Za-z0-9_]/g, "")}' order by ordinal_position`;
const c = new pg.Client({ connectionString: String(url).replace(/\?.*$/, ""), statement_timeout: 60000 });
try {
  await c.connect();
  const r = await c.query(sql);
  const rows = r.rows ?? [];
  console.log(JSON.stringify(rows.slice(0, 300)));
  if (rows.length > 300) console.log(`... ${rows.length} rows total`);
} catch (e) { console.error("sql error:", e.message); process.exit(1); } finally { await c.end().catch(() => {}); }
