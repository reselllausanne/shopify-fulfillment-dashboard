#!/usr/bin/env node
// Read-only SQL. Usage: sav-sql "select ..."   |   sav-sql --tables   |   sav-sql --schema <Table>
import pg from "pg";
const url = process.env.SAV_DATABASE_URL;
if (!url) { console.error("SAV_DATABASE_URL missing"); process.exit(2); }
const arg = process.argv.slice(2);
let sql = arg[0] ?? "";
if (sql === "--tables") sql = `select table_name from information_schema.tables where table_schema='public' order by 1`;
else if (sql === "--schema") {
  const t = String(arg[1] ?? "").replace(/[^A-Za-z0-9_]/g, "");
  sql = `select column_name, data_type from information_schema.columns where table_schema='public' and table_name='${t}' order by ordinal_position`;
}
if (!/^\s*(select|with)\b/i.test(sql) || /;\s*\S/.test(sql) ||
    /\b(insert|update|delete|drop|alter|truncate|create|grant|copy|call|do)\b/i.test(sql)) {
  console.error("refused: single SELECT only"); process.exit(2);
}
if (/health_|StockXToken|PartnerUser/i.test(sql)) { console.error("refused: out of scope"); process.exit(2); }
const c = new pg.Client({ connectionString: url.replace(/\?.*$/, ""), statement_timeout: 20000, options: "-c default_transaction_read_only=on" });
try {
  await c.connect();
  const r = await c.query(sql.replace(/;\s*$/, ""));
  const rows = r.rows.slice(0, 200);
  console.log(JSON.stringify(rows, null, 0));
  if (r.rows.length > 200) console.log(`... truncated, ${r.rows.length} rows total. Add LIMIT/WHERE.`);
} catch (e) { console.error("sql error:", e.message); process.exit(1); } finally { await c.end().catch(() => {}); }
