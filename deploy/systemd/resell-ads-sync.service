[Unit]
Description=Resell Ads daily sync and validate
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/resell
ExecStart=/usr/bin/env bash -lc 'docker compose exec -T web npm run ads -- backfill --days=14 && docker compose exec -T web npm run ads -- validate --days=30'
StandardOutput=journal
StandardError=journal
