[Unit]
Description=Resell Ads explorer reconciler (metric sync, rules, Merchant, readback, commit)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/resell
EnvironmentFile=-/etc/default/resell-ads
# Isolated `run` (not `exec` into web): a web recreate used to SIGKILL the job (exit 137).
# Runs all active batches, so one stuck batch no longer blocks the others.
TimeoutStartSec=6h
TimeoutStopSec=15min
KillMode=mixed
OOMPolicy=continue
ExecStart=/usr/bin/env bash -lc 'docker rm -f resell-ads-reconcile >/dev/null 2>&1 || true; docker compose run --no-deps --rm -T --name resell-ads-reconcile web npm run ads -- explorer:reconcile:all --max-transitions=300'
StandardOutput=journal
StandardError=journal
