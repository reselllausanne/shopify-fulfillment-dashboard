[Unit]
Description=Resell tracking shadow reconciliation (funnel vs Shopify)
After=network.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/resell
ExecStart=/usr/bin/env bash -lc 'docker compose exec -T web npx tsx scripts/tracking-shadow-report.ts --days=7 --alert'
StandardOutput=journal
StandardError=journal
