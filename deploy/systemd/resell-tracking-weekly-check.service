[Unit]
Description=Resell tracking Friday digeste
After=network.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/resell
# Host has no Node/npx — run inside web container (same pattern as secondary-upload / shadow-report).
ExecStart=/usr/bin/env bash -lc 'docker compose exec -T web bash scripts/tracking-weekly-check.sh'
StandardOutput=journal
StandardError=journal
