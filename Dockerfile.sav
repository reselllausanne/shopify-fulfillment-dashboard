# SAV agent image. Cursor SDK local mode needs Node >= 22.13 (main image is Node 20).
FROM node:22-bookworm-slim
ENV NEXT_TELEMETRY_DISABLED=1 TZ=Europe/Zurich
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git ripgrep openssl python3 && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
COPY prisma ./prisma
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --include=dev
COPY . .
ENV NODE_ENV=production
CMD ["node", "sav-agent/server.mjs"]
